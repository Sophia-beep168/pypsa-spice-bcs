# Ignore everything under pypsa-spice-data by default
/pypsa-spice-data/**

# Ignore large / generated files
*.nc
*.log

# Allow project_02 inputs (and the folders leading to them)
!/pypsa-spice-data/
!/pypsa-spice-data/project_02/
!/pypsa-spice-data/project_02/input/
!/pypsa-spice-data/project_02/input/**

# Still ignore results even inside project_02
/pypsa-spice-data/**/results/
/pypsa-spice-data/*/pre-solve/
/pypsa-spice-data/*/post-solve/
